        "jsonBody": "={{ JSON.stringify({\n  speaker: $('Webhook WhatsApp (Evolution API)').item.json.body?.data?.pushName || $('Webhook WhatsApp (Evolution API)').item.json.body?.data?.key?.remoteJid?.split('@')[0] || 'Desconhecido',\n  raw_text: $('Speech-to-Text (POST /transcribe)').item.json.text || '',\n  revised_text: $('AI Gateway (POST /ai/revise)').item.json.text_revised || $('Speech-to-Text (POST /transcribe)').item.json.text || '',\n  audio_duration_s: $('Speech-to-Text (POST /transcribe)').item.json.duration || 0,\n  audio_filename: $('Speech-to-Text (POST /transcribe)').item.json.audio_id || 'audio.ogg',\n  meta_info: {\n    source: 'whatsapp',\n    message_type: 'audio',\n    remoteJid: $('Webhook WhatsApp (Evolution API)').item.json.body?.data?.key?.remoteJid,\n    pushName: $('Webhook WhatsApp (Evolution API)').item.json.body?.data?.pushName\n  }\n}) }}",
        "options": {}
