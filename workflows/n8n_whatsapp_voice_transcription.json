{
  "name": "Hermes Voice Memory - MVP 1 Transcrição e Revisão WhatsApp",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-voice-received",
        "options": {}
      },
      "name": "Webhook WhatsApp (Evolution API / Z-API)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [180, 300],
      "id": "1e112d7c-a7a2-4bb0-80a1-000000000001"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body?.data?.messageType || $json.body?.messageType || ($json.body?.data?.message?.audioMessage ? 'audioMessage' : '') }}",
              "operation": "contains",
              "value2": "audio"
            }
          ]
        }
      },
      "name": "Filtro: É Mensagem de Áudio?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [400, 300],
      "id": "1e112d7c-a7a2-4bb0-80a1-000000000002"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHATSAPP_MEDIA_ENDPOINT || 'http://evolution-api:8080/chat/getBase64FromMediaMessage/hermes' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.WHATSAPP_API_TOKEN || 'seu_token_whatsapp_aqui' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": {\n    \"key\": {\n      \"id\": \"{{ $('Webhook WhatsApp (Evolution API / Z-API)').item.json.body?.data?.key?.id }}\",\n      \"fromMe\": {{ $('Webhook WhatsApp (Evolution API / Z-API)').item.json.body?.data?.key?.fromMe ? true : false }},\n      \"remoteJid\": \"{{ $('Webhook WhatsApp (Evolution API / Z-API)').item.json.body?.data?.key?.remoteJid }}\"\n    }\n  },\n  \"convertToMp4\": false\n}",
        "options": {}
      },
      "name": "Baixar Base64 (Evolution API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [620, 200],
      "id": "1e112d7c-a7a2-4bb0-80a1-000000000006"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HERMES_API_URL || 'http://host.docker.internal:8000' }}/transcribe/base64",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"base64\": \"{{ $json.base64 }}\",\n  \"language\": \"pt\"\n}",
        "options": {}
      },
      "name": "Speech-to-Text (POST /transcribe)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [840, 200],
      "id": "1e112d7c-a7a2-4bb0-80a1-000000000003"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HERMES_API_URL || 'http://host.docker.internal:8000' }}/ai/revise",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $json.text }}\",\n  \"context\": \"Mensagem de voz via WhatsApp do usuário.\"\n}",
        "options": {}
      },
      "name": "AI Gateway (POST /ai/revise)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1060, 200],
      "id": "1e112d7c-a7a2-4bb0-80a1-000000000004"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HERMES_API_URL || 'http://host.docker.internal:8000' }}/api/v1/memory/messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"speaker\": \"{{ $('Webhook WhatsApp (Evolution API / Z-API)').item.json.body?.data?.pushName || $('Webhook WhatsApp (Evolution API / Z-API)').item.json.body?.data?.key?.remoteJid || 'user' }}\",\n  \"raw_text\": \"{{ $('Speech-to-Text (POST /transcribe)').item.json.text }}\",\n  \"revised_text\": \"{{ $json.text_revised }}\",\n  \"audio_duration_s\": {{ $('Speech-to-Text (POST /transcribe)').item.json.duration || 0 }},\n  \"meta_info\": {\n    \"remoteJid\": \"{{ $('Webhook WhatsApp (Evolution API / Z-API)').item.json.body?.data?.key?.remoteJid }}\",\n    \"message_id\": \"{{ $('Webhook WhatsApp (Evolution API / Z-API)').item.json.body?.data?.key?.id }}\"\n  }\n}",
        "options": {}
      },
      "name": "Gravar na Memória Hermes (POST /memory)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1280, 100],
      "id": "1e112d7c-a7a2-4bb0-80a1-000000000007"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHATSAPP_API_ENDPOINT || 'http://evolution-api:8080/message/sendText/hermes' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.WHATSAPP_API_TOKEN || 'seu_token_whatsapp_aqui' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $('Webhook WhatsApp (Evolution API / Z-API)').item.json.body?.data?.key?.remoteJid || $('Webhook WhatsApp (Evolution API / Z-API)').item.json.body?.sender?.phone }}\",\n  \"text\": \"🎙️ James (Mordomo Virtual)\\n\\n_Transcrição_:\\n{{ $json.text_revised }}\"\n}",
        "options": {}
      },
      "name": "Envia Texto Revisado (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1280, 300],
      "id": "1e112d7c-a7a2-4bb0-80a1-000000000005"
    }
  ],
