        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"base64\": \"{{ $json.base64 }}\",\n  \"language\": \"pt\"\n}",
        "options": {}
      },
      "name": "Speech-to-Text (POST /transcribe)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
