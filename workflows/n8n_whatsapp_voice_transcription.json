      "position": [600, 420],
      "id": "4e112d7c-a7a2-4bb0-80a1-000000000002"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HERMES_API_URL || 'http://host.docker.internal:8000' }}/api/v1/memory/query",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: ($json.body?.data?.message?.conversation || $json.body?.data?.message?.extendedTextMessage?.text || $json.body?.text || $json.body?.message || '').replace(/^(\\?|\\/hermes|hermes,)\\s*/i, ''), top_k: 5, include_graph: true }) }}",
        "options": {}
      },
