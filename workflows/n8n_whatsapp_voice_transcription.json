{
  "name": "Hermes Voice Memory - Orquestrador WhatsApp Unificado (Voz & Q&A Hermes)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-voice-received",
        "options": {}
      },
      "name": "Webhook WhatsApp (Evolution API)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [160, 300],
      "id": "1e112d7c-a7a2-4bb0-80a1-000000000001"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body?.data?.messageType || $json.body?.messageType || ($json.body?.data?.message?.audioMessage ? 'audioMessage' : '') }}",
              "operation": "contains",
              "value2": "audio"
            }
          ]
        }
      },
      "name": "É Mensagem de Áudio?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [380, 300],
      "id": "1e112d7c-a7a2-4bb0-80a1-000000000002"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHATSAPP_MEDIA_ENDPOINT || 'http://evolution-api:8080/chat/getBase64FromMediaMessage/hermes' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.WHATSAPP_API_TOKEN || 'seu_token_whatsapp_aqui' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": {\n    \"key\": {\n      \"id\": \"{{ $('Webhook WhatsApp (Evolution API)').item.json.body?.data?.key?.id }}\",\n      \"fromMe\": {{ $('Webhook WhatsApp (Evolution API)').item.json.body?.data?.key?.fromMe ? true : false }},\n      \"remoteJid\": \"{{ $('Webhook WhatsApp (Evolution API)').item.json.body?.data?.key?.remoteJid }}\"\n    }\n  },\n  \"convertToMp4\": false\n}",
        "options": {}
      },
      "name": "Baixar Base64 (Evolution API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [600, 200],
      "id": "1e112d7c-a7a2-4bb0-80a1-000000000006"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HERMES_API_URL || 'http://host.docker.internal:8000' }}/transcribe/base64",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"base64\": \"{{ $json.base64 }}\",\n  \"language\": \"pt\"\n}",
        "options": {}
      },
      "name": "Speech-to-Text (POST /transcribe)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [820, 200],
      "id": "1e112d7c-a7a2-4bb0-80a1-000000000003"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HERMES_API_URL || 'http://host.docker.internal:8000' }}/ai/revise",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, context: 'Mensagem de voz via WhatsApp do usuário.' }) }}",
        "options": {}
      },
      "name": "AI Gateway (POST /ai/revise)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1040, 200],
      "id": "1e112d7c-a7a2-4bb0-80a1-000000000004"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHATSAPP_API_ENDPOINT || 'http://evolution-api:8080/message/sendText/hermes' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.WHATSAPP_API_TOKEN || 'seu_token_whatsapp_aqui' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Webhook WhatsApp (Evolution API)').item.json.body?.data?.key?.remoteJid || $('Webhook WhatsApp (Evolution API)').item.json.body?.sender?.phone || '', text: '🎙️ James (Mordomo Virtual)\\n\\n_Transcrição_:\\n' + ($json.text_revised || $json.text || '') }) }}",
        "options": {}
      },
      "name": "Envia Transcrição James (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1260, 200],
      "id": "1e112d7c-a7a2-4bb0-80a1-000000000005"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body?.data?.message?.conversation || $json.body?.data?.message?.extendedTextMessage?.text || $json.body?.text || $json.body?.message || '' }}",
              "operation": "regex",
              "value2": "^(\\?|/hermes|hermes,)"
            }
          ]
        }
      },
      "name": "É Pergunta para o Hermes?",
