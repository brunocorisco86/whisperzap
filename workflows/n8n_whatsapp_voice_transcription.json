    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HERMES_API_URL || 'http://host.docker.internal:8000' }}/ai/revise",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, context: 'Mensagem de voz via WhatsApp do usuário.' }) }}",
        "options": {}
      },
