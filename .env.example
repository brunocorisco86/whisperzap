# ==========================================
# HERMES VOICE MEMORY - CONFIGURAÇÕES DE AMBIENTE
# ==========================================

# Configurações Gerais
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==========================================
# PROVIDERS DE INTELIGÊNCIA ARTIFICIAL (AI GATEWAY)
# ==========================================
# Opções de AI_PROVIDER: gemini, openrouter, local
AI_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-3.1-flash-lite

# Chaves de API de Provedores
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Modelos por Tarefa (Model Router)
MODEL_REVISE=gemini-3.1-flash-lite
MODEL_EXTRACT=gemini-3.1-flash-lite
MODEL_SUMMARIZE=gemini-3.1-flash-lite
MODEL_WEEKLY=gemini-3.1-flash-lite

# Logs de IA (Cuidado: não ative em produção sem criptografia)
AI_LOG_PROMPTS=false
AI_LOG_RESPONSES=false

# ==========================================
# SPEECH-TO-TEXT (WHISPER)
# ==========================================
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ==========================================
# BANCO DE DADOS (POSTGRESQL + PGVECTOR)
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hermes_voice_memory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# ==========================================
# INTEGRAÇÃO N8N & WHATSAPP API
# ==========================================
N8N_WEBHOOK_URL=http://localhost:5678/webhook/voice-received
WHATSAPP_API_TOKEN=seu_token_evolution_api_aqui

# ==========================================
# IDENTIFICAÇÃO DO PROPRIETÁRIO & REGRAS DE FILTRO
# ==========================================
USER_PHONE_NUMBER=554497604925
USER_NAME=Bruno
USER_ALIASES=Bruno,user,eu,me,admin,554497604925,5544979604925
IGNORE_GROUP_MESSAGES=true
AI_BYPASS_CHAR_THRESHOLD=15
AI_BYPASS_WORD_THRESHOLD=3
AI_BYPASS_PHRASES=bom dia,boa tarde,boa noite,oi,olá,ola,ok,beleza,valeu,obrigado,obrigada,meu nome,sim,não,nao,tchau,ate mais,até mais,opa

# ==========================================
# GRAPHIFY (MAPEAMENTO DE CONTEXTO)
# ==========================================
GRAPHIFY_GEMINI_MODEL=gemini-3.1-flash-lite

# ==========================================
# AUTENTICAÇÃO DO DASHBOARD WEB
# ==========================================
DASHBOARD_PASSWORD=blurbang
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_SESSION_SECRET=whisperzap_secret_session_key_2026
