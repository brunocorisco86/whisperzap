# ==============================================================================
# Caddyfile — Reverse Proxy Multi-Serviços com HTTPS Automático
# ==============================================================================

{
    # Configuração de e-mail para Let's Encrypt / ZeroSSL (definido via .env ou padrão)
    email {$ACME_EMAIL:bconter@outlook.com}
    # Modo de administração desabilitado para maior segurança
    admin off
}

# Bloco principal: responde no domínio configurado ou no IP local / Tailscale
{$HERMES_DOMAIN::80} {
    # Compressão de respostas HTTP para menor tráfego e latência
    encode zstd gzip

    # Cabeçalhos de Segurança
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    # Redirecionamento da raiz para /mnemosine/
    redir / /mnemosine/ 308
    redir /mnemosine /mnemosine/ 308

    # Serviço 1: Mnemosine Voice Intelligence & Control Hub
    handle /mnemosine* {
        reverse_proxy hermes-api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Assets estáticos do Mnemosine
    handle /static/* {
        reverse_proxy hermes-api:8000
    }

    # Webhook nativo do WhatsApp (Evolution API -> Hermes)
    handle /api/v1/whatsapp/* {
        reverse_proxy hermes-api:8000
    }

    # Rota de health check pública
    handle /health {
        reverse_proxy hermes-api:8000
    }

    # --------------------------------------------------------------------------
    # Espaço reservado para futuros serviços (Exemplos):
    # --------------------------------------------------------------------------
    # handle /evolution* {
    #     reverse_proxy hermes-evolution-api:8080
    # }
    # handle /n8n* {
    #     reverse_proxy n8n:5678
    # }
    # handle /grafana* {
    #     reverse_proxy grafana:3000
    # }

    # Logs de acesso estruturados em JSON
    log {
        output stdout
        format json
    }
}
